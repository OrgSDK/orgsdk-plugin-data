{
	"name": "@orgsdk/plugin-data",
	"version": "1.0.2",
	"description": "Data utilities: HTTP fetching, array processing, transformation, currency conversion, and PDF extraction",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"validate": "orgsdk-plugin validate",
		"package": "orgsdk-plugin package",
		"version-guard": "orgsdk-plugin version-guard",
		"publish": "orgsdk-plugin publish",
		"build": "bun run typecheck && bun run validate && bun run package"
	},
	"dependencies": {
		"unpdf": "^1.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@orgsdk/plugins": "0.2.2",
		"@types/bun": "^1.3.9",
		"typescript": "~7.0.2"
	}
}
